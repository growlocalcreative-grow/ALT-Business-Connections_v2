# APP_URL: The public URL where this app is hosted.
APP_URL="https://altbusinessconnections.org"

# Firebase Configuration (Vite Client-Side)
# In Cloudflare Pages, add these in 'Settings' -> 'Environment Variables' with the 'VITE_' prefix.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# GEMINI_API_KEY: Required if you implement server-side AI features.
# Note: For security, do not use VITE_ prefix for secrets used in Workers/Functions.
GEMINI_API_KEY=""
