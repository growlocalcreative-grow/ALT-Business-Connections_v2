{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alt-business-connections",
  "compatibility_date": "2024-04-01",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MAILGUN_DOMAIN": "newsletter.altbusinessconnections.org",
    "MAILGUN_FROM_EMAIL": "updates@newsletter.altbusinessconnections.org",
    "MAILGUN_REPLY_TO": "growlocalcreative@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
